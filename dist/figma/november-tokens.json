              "Inter",
              "system-ui",
              "sans-serif"
            ],
            "$description": "Reserved for editorial or one-off components"
          },
          "code": {
            "$type": "fontFamily",
            "$value": [
              "JetBrains Mono",
              "monospace"
            ],
            "$description": "Monospace — not brand-driven"
          }
