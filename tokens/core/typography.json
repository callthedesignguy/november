{
  "font": {
    "family": {
      "primary":   { "$type": "fontFamily", "$value": ["Geist", "system-ui", "-apple-system", "sans-serif"], "$description": "Heading/display font — override per theme" },
      "secondary": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "-apple-system", "sans-serif"], "$description": "Body/copy font — override per theme" },
      "accent":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"],                  "$description": "Reserved for editorial or one-off components" },
      "code":      { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"],                       "$description": "Monospace — not brand-driven" }
    },
    "leading": {
      "none":    { "$type": "number", "$value": 1.0,   "$description": "Display" },
      "tighter": { "$type": "number", "$value": 1.1,   "$description": "Heading/xl–7xl" },
      "tight":   { "$type": "number", "$value": 1.2,   "$description": "Heading/xxs–lg, Body/accent" },
      "normal":  { "$type": "number", "$value": 1.5,   "$description": "Body/xs, Body/sm, Code/base" },
      "relaxed": { "$type": "number", "$value": 1.625 },
      "loose":   { "$type": "number", "$value": 1.8,   "$description": "Body/base, Body/lg, Body/xl" }
    },
    "tracking": {
      "heading": { "$type": "string", "$value": "-0.04em", "$description": "All heading and display styles" }
    }
  },
  "text": {
    "body": {
      "accent":  { "$type": "dimension", "$value": "8px",  "$description": "Body/accent" },
      "xs":      { "$type": "dimension", "$value": "10px", "$description": "Body/xs" },
      "fine":    { "$type": "dimension", "$value": "11px", "$description": "Body/fine" },
      "caption": { "$type": "dimension", "$value": "12px", "$description": "Body/caption, Body/sm" },
      "base":    { "$type": "dimension", "$value": "16px", "$description": "Body/base" },
      "lg":      { "$type": "dimension", "$value": "20px", "$description": "Body/lg" },
      "xl":      { "$type": "dimension", "$value": "24px", "$description": "Body/xl" }
    },
    "heading": {
      "xxs":     { "$type": "dimension", "$value": "12px",  "$description": "Heading/xxs" },
      "xs":      { "$type": "dimension", "$value": "14px",  "$description": "Heading/xs" },
      "sm":      { "$type": "dimension", "$value": "16px",  "$description": "Heading/sm" },
      "md":      { "$type": "dimension", "$value": "18px",  "$description": "Heading/md" },
      "lg":      { "$type": "dimension", "$value": "20px",  "$description": "Heading/lg" },
      "xl":      { "$type": "dimension", "$value": "24px",  "$description": "Heading/xl" },
      "2xl":     { "$type": "dimension", "$value": "32px",  "$description": "Heading/2xl" },
      "3xl":     { "$type": "dimension", "$value": "48px",  "$description": "Heading/3xl" },
      "4xl":     { "$type": "dimension", "$value": "64px",  "$description": "Heading/4xl" },
      "5xl":     { "$type": "dimension", "$value": "80px",  "$description": "Heading/5xl" },
      "6xl":     { "$type": "dimension", "$value": "96px",  "$description": "Heading/6xl" },
      "7xl":     { "$type": "dimension", "$value": "120px", "$description": "Heading/7xl" },
      "display": { "$type": "dimension", "$value": "200px", "$description": "Display" }
    },
    "code": {
      "base": { "$type": "dimension", "$value": "13px", "$description": "Code/base" }
    }
  }
}
