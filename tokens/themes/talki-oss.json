{
  "$description": "Talki OSS — open source screen recording and video sharing product.",
  "color": {
    "brand":            { "$type": "color", "$value": "#0E2FB4" },
    "brand-hover":      { "$type": "color", "$value": "#0B25A0" },
    "brand-secondary":  { "$type": "color", "$value": "#FF2736" },
    "secondary":        { "$type": "color", "$value": "#0E2FB4", "$description": "Hippo-specific slot — stub for variable collection consistency" },
    "secondary-subtle": { "$type": "color", "$value": "rgba(14, 47, 180, 0.08)", "$description": "Hippo-specific slot — stub" },

    "accent-a":        { "$type": "color", "$value": "#0E2FB4", "$description": "Hippo-specific slot — stub" },
    "accent-a-dark":   { "$type": "color", "$value": "#0B25A0", "$description": "Hippo-specific slot — stub" },
    "accent-b":        { "$type": "color", "$value": "#0E2FB4", "$description": "Hippo-specific slot — stub" },
    "accent-b-dark":   { "$type": "color", "$value": "#0B25A0", "$description": "Hippo-specific slot — stub" },
    "accent-c":        { "$type": "color", "$value": "#0E2FB4", "$description": "Hippo-specific slot — stub" },
    "accent-c-dark":   { "$type": "color", "$value": "#0B25A0", "$description": "Hippo-specific slot — stub" },
    "accent-c-light":  { "$type": "color", "$value": "rgba(14, 47, 180, 0.08)", "$description": "Hippo-specific slot — stub" },

    "surface": {
      "highlight":         { "$type": "color", "$value": "#FEFEFE" },
      "primary":           { "$type": "color", "$value": "#F9FAFE" },
      "secondary":         { "$type": "color", "$value": "#F0F2FC" },
      "tertiary":          { "$type": "color", "$value": "#E2E6F4" },
      "inverse-highlight": { "$type": "color", "$value": "#2A3A7A" },
      "inverse-primary":   { "$type": "color", "$value": "#1C2B6A" },
      "inverse-secondary": { "$type": "color", "$value": "#0F1D55" },
      "inverse-tertiary":  { "$type": "color", "$value": "#081040" }
    },

    "text": {
      "base":                { "$type": "color", "$value": "#111827" },
      "neutral":             { "$type": "color", "$value": "#4B5563" },
      "placeholder":         { "$type": "color", "$value": "#9CA3AF" },
      "disabled":            { "$type": "color", "$value": "#9EA5BF" },
      "brand":               { "$type": "color", "$value": "#0E2FB4" },
      "danger":              { "$type": "color", "$value": "#BB2626" },
      "warning":             { "$type": "color", "$value": "#994C06" },
      "success":             { "$type": "color", "$value": "#076A51" },
      "inverse-base":        { "$type": "color", "$value": "#FFFFFF" },
      "inverse-neutral":     { "$type": "color", "$value": "#C7D2FE" },
      "inverse-placeholder": { "$type": "color", "$value": "#A5B4FC" }
    },

    "border": {
      "light":   { "$type": "color", "$value": "#F7F8FD" },
      "default": { "$type": "color", "$value": "#F0F2FC" },
      "strong":  { "$type": "color", "$value": "#E2E6F4" }
    },

    "action": {
      "fill":              { "$type": "color", "$value": "#0E2FB4" },
      "fill-hover":        { "$type": "color", "$value": "#0B25A0" },
      "fill-subtle":       { "$type": "color", "$value": "rgba(14, 47, 180, 0.08)" },
      "fill-subtle-hover": { "$type": "color", "$value": "rgba(14, 47, 180, 0.14)" },
      "on-fill":           { "$type": "color", "$value": "#FFFFFF" }
    },

    "status": {
      "warning":         { "$type": "color", "$value": "#F59E0B" },
      "warning-subtle":  { "$type": "color", "$value": "#FEF3C7" },
      "negative":        { "$type": "color", "$value": "#DC2626" },
      "negative-subtle": { "$type": "color", "$value": "#FEE2E2" },
      "positive":        { "$type": "color", "$value": "#10B981" },
      "positive-subtle": { "$type": "color", "$value": "#D1FAE5" }
    },

    "overlay": {
      "light": { "$type": "color", "$value": "rgba(0, 0, 0, 0.04)" },
      "med":   { "$type": "color", "$value": "rgba(0, 0, 0, 0.08)" },
      "dark":  { "$type": "color", "$value": "rgba(0, 0, 0, 0.16)" }
    },
    "scrim": { "$type": "color", "$value": "rgba(0, 0, 0, 0.40)" }
  },
  "font": {
    "family": {
      "primary":   { "$type": "fontFamily", "$value": ["Stack Sans Text", "system-ui", "sans-serif"] },
      "secondary": { "$type": "fontFamily", "$value": ["Stack Sans Text", "system-ui", "sans-serif"] },
      "accent":    { "$type": "fontFamily", "$value": ["Stack Sans Notch", "system-ui", "sans-serif"] },
      "code":      { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium":  { "$type": "fontWeight", "$value": 500 },
      "bold":    { "$type": "fontWeight", "$value": 600, "$description": "Talki uses semi-bold (600) as its bold weight" }
    }
  }
}
