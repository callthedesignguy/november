{
  "name": "@callthedesignguy/november-tokens",
  "version": "0.1.2",
  "description": "November design system — shared tokens for Plumb, Hippo, and Talki-OSS",
  "type": "module",
  "main": "dist/js/tokens.js",
  "exports": {
    ".": "./dist/js/tokens.js",
    "./css": {
      "style": "./dist/css/core.css",
      "default": "./dist/css/core.css"
    },
    "./themes/*": {
      "style": "./dist/css/themes/*.css",
      "default": "./dist/css/themes/*.css"
    }
  },
  "scripts": {
    "build": "node sd.config.js",
    "watch": "node --watch sd.config.js"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "style-dictionary": "^4.3.0"
  }
}
